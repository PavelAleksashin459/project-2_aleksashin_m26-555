[0.000, "o", "\r\r\n"]
[0.100, "o", "database\r\n\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\n***Операции с данными***\r\nФункции:\r\n<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) - создать запись.\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию.\r\n<command> select from <имя_таблицы> - прочитать все записи.\r\n<command> update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец_условия> = <значение_условия> - обновить запись.\r\n<command> delete from <имя_таблицы"]
[0.000, "o", "> where <столбец> = <значение> - удалить запись.\r\n<command> info <имя_таблицы> - вывести информацию о таблице.\r\n\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\n"]
[0.001, "o", ">>>Введите команду: "]
[10.126, "o", "create_table users name:str age:int is_active:bool"]
[0.517, "o", "\r\n"]
[0.004, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n>>>Введите команду: "]
[5.891, "o", "insert into users values (\"Sergei\", 28, true)"]
[0.489, "o", "\r\n"]
[0.004, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[0.001, "o", ">>>Введите команду: "]
[5.673, "o", "select from users"]
[0.511, "o", "\r\n"]
[0.038, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n>>>Введите команду: "]
[5.569, "o", "select from users where age = 28"]
[0.415, "o", "\r\n"]
[0.007, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[0.000, "o", ">>>Введите команду: "]
[7.998, "o", "update users set age = 29 where name = \"Sergei\""]
[0.831, "o", "\r\n"]
[0.003, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n>>>Введите команду: "]
[4.868, "o", "delete from users where ID = 1"]
[0.277, "o", "\r\n"]
[0.006, "o", "Запись с ID=1 успешно удалена из таблицы \"users\".\r\n>>>Введите команду: "]
[5.321, "o", "info users"]
[0.477, "o", "\r\n"]
[0.008, "o", "Таблица: users\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\n"]
[0.000, "o", "Количество записей: 0\r\n>>>Введите команду: "]
[1.671, "o", "e"]
