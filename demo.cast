[0.000, "o", "\r\r\n"]
[1.015, "o", "database\r\n\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\n***Операции с данными***\r\nФункции:\r\n<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) - создать запись.\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию.\r\n<command> select from <имя_таблицы> - прочитать все записи.\r\n<command> update <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец_условия> = <значение_условия> - обновить запись.\r\n<command> delete from <имя_таблицы"]
[0.000, "o", "> where <столбец> = <значение> - удалить запись.\r\n<command> info <имя_таблицы> - вывести информацию о таблице.\r\n\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\r\n\r\n"]
[0.001, "o", ">>>Введите команду: "]
[6.218, "o", "insert into users values (\"Anna\", abc, true)"]
[0.469, "o", "\r\n"]
[0.007, "o", "Ошибка валидации: значение <abc> не подходит для столбца age:int.\r\n"]
[0.000, "o", ">>>Введите команду: "]
[5.179, "o", "i"]
[0.427, "o", "nsert into users values (\"Sergei\", 28, true)"]
[0.399, "o", "\r\n"]
[0.007, "o", "Функция insert выполнилась за 0.001 секунд.\r\n"]
[0.001, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[0.000, "o", ">>>Введите команду: "]
[6.275, "o", "select from users"]
[0.370, "o", "\r\n"]
[0.005, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[3.345, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n>>>Введите команду: "]
[1.868, "o", "delete from users where ID = 1"]
[4.831, "o", "\r\n"]
[0.005, "o", "Вы уверены, что хотите выполнить \"удаление записи\"? [y/n]: "]
[0.867, "o", "y"]
[1.630, "o", "\r\n"]
[0.004, "o", "Запись с ID=1 успешно удалена из таблицы \"users\".\r\n"]
[0.000, "o", ">>>Введите команду: "]
[10.047, "o", "drop_table users"]
[0.602, "o", "\r\n"]
[0.004, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[1.012, "o", "n"]
[0.536, "o", "\r\n"]
[0.001, "o", "Операция отменена.\r\n"]
[0.001, "o", ">>>Введите команду: "]
[3.623, "o", "^D\b\b"]
